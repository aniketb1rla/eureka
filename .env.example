# Copy to .env for local runs. There is deliberately no GEMINI_API_KEY here:
#   locally the key lives in Windows Credential Manager (python -m scripts.set_gemini_key)
#   in production it is a Secret Manager file mount (GEMINI_API_KEY_FILE)
APP_ENV=local
# fake = no model calls and no cost; real = uses your key
GEMINI_MODE=fake
PUBLIC_ORIGIN=http://127.0.0.1:8010

# Limits. Allowances are lifetime per verified user; the daily caps stop ALL generation.
FREE_IMAGE_ALLOWANCE=10
FREE_VIDEO_ALLOWANCE=1
GLOBAL_DAILY_IMAGE_CAP=200
GLOBAL_DAILY_VIDEO_CAP=20
MAX_ACTIVE_JOBS_PER_USER=3
